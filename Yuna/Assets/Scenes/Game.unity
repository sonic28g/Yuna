--- !u!114 &1148254015
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1148254013}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "To the Esteemed Shogun,\n\nI write to you not as a daughter blinded by
    grief, but as a loyal subject who seeks truth above all.\n\nMy father, Lord Daichi,
    has been accused of treason\u2014a crime that, if true, would bring shame to
    our name. But I have found evidence that suggests otherwise. Documents forged
    in his name, weapon purchases he never approved, and letters that reveal the
    hand of another: Lord Ishikawa.\n\nThese were not the actions of a traitor, but
    the work of someone intent on removing my father through deceit and manipulation.\n\nI
    do not ask for mercy. I ask for justice.\n\nPlease allow a proper investigation.
    Let the truth rise, no matter whom it condemns.\n\nRespectfully,\nYuna, daughter
    of Lord Daichi"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 6d691116db8b14525af5e89d41049aae, type: 2}
